@Composable
fun PasswordDotsField(
    password: String,
    onPasswordChange: (String) -> Unit,
    modifier: Modifier = Modifier
) {
    Column(
        modifier = modifier,
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Row(
            horizontalArrangement = Arrangement.spacedBy(12.dp),
            modifier = Modifier.padding(bottom = 8.dp)
        ) {
            repeat(6) { index ->
                Box(
                    modifier = Modifier
                        .size(50.dp)
                        .clip(CircleShape)
                        .border(
                            2.dp,
                            if (index < password.length) Color(0xFFFF7900) else Color(0xFFE0E0E0),
                            CircleShape
                        )
                        .background(
                            if (index < password.length) Color(0xFFFF7900) else Color.White
                        ),
                    contentAlignment = Alignment.Center
                ) {
                    if (index < password.length) {
                        Text(
                            text = "•",
                            color = Color.White,
                            fontSize = 24.sp
                        )
                    }
                }
            }
        }
        
        Text(
            text = "6 خانات فقط",
            fontSize = 12.sp,
            color = Color(0xFF666666)
        )
    }
    
    TextField(
        value = password,
        onValueChange = { 
            if (it.length <= 6 && it.all { char -> char.isDigit() }) {
                onPasswordChange(it)
            }
        },
        modifier = Modifier.size(0.dp),
        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword),
        enabled = false
    )
}

