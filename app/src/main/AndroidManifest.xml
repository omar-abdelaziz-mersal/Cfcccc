@Composable
fun OrangeCashApp() {
    var currentScreen by remember { mutableStateOf("login") }
    var walletNumber by remember { mutableStateOf("") }
    var savedPassword by remember { mutableStateOf("") }
    var transferAmount by remember { mutableStateOf("") }
    var recipientNumber by remember { mutableStateOf("") }
    var transactionId by remember { mutableStateOf("") }
    var transactionDate by remember { mutableStateOf("") }
    
    val context = LocalContext.current
    val notificationHelper = remember { NotificationHelper(context) }
    
    fun generateTransactionId(): String {
        val chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        return (1..16).map { chars.random() }.joinToString("")
    }
    
    fun getCurrentDate(): String {
        val sdf = SimpleDateFormat("dd/MM/yyyy", Locale("ar"))
        return sdf.format(Date())
    }
    
    when (currentScreen) {
        "login" -> LoginScreen(
            onLogin = { number, password ->
                walletNumber = number
                savedPassword = password
                currentScreen = "home"
            }
        )
        "home" -> HomeScreen(
            walletNumber = walletNumber,
            onCheckBalance = { password ->
                if (password == savedPassword) {
                    // كشف الرصيد
                }
            },
            onTransferClick = {
                currentScreen = "transfer"
            }
        )
        "transfer" -> TransferScreen(
            onBack = { currentScreen = "home" },
            onTransfer = { amount, recipient ->
                transferAmount = amount
                recipientNumber = recipient
                currentScreen = "password"
            }
        )
        "password" -> PasswordScreen(
            savedPassword = savedPassword,
            onBack = { currentScreen = "transfer" },
            onSuccess = {
                currentScreen = "loading"
                transactionId = generateTransactionId()
                transactionDate = getCurrentDate()
                
                Handler(Looper.getMainLooper()).postDelayed({
                    notificationHelper.showTransferNotification(
                        transferAmount,
                        recipientNumber,
                        "1.00"
                    )
                    currentScreen = "success"
                }, 4000)
            }
        )
        "loading" -> LoadingScreen()
        "success" -> SuccessScreen(
            onBack = { currentScreen = "home" },
            amount = transferAmount,
            recipient = recipientNumber,
            transactionId = transactionId,
            date = transactionDate
        )
    }
}

